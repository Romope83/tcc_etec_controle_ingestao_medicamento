<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="IngestaoMed.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:IngestaoMed"
    xmlns:views="clr-namespace:IngestaoMed.Views" 
    Title="IngestaoMed">

    <ShellContent
        Title="Cadastro"
        ContentTemplate="{DataTemplate views:CadastroPage}"
        Route="CadastroPage" />

    <ShellContent
        Title="Login"
        ContentTemplate="{DataTemplate views:LoginPage}"
        Route="LoginPage" />

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage"
        FlyoutItemIsVisible="False" />
    <ShellContent
    Title="CadastroMed"
    ContentTemplate="{DataTemplate views:CadastroMedicamentoPage}"
    Route="CadastroMedPage" />

</Shell>