<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:IngestaoMed.Core.ViewModels;assembly=IngestaoMed.Core"
             x:Class="IngestaoMed.Views.CadastroPage"
             x:DataType="vm:CadastroViewModel"
             Title="Cadastro">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">

            <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                <Label Text="Bem-vindo ao IngestaoMed" Style="{StaticResource Headline}" />
                <Label Text="Cadastre o cuidador para gerenciar os alertas." 
                       TextColor="{StaticResource Gray600}" 
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">
                <Label Text="Nome do Cuidador" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                <Border StrokeShape="RoundRectangle 8">
                    <Entry Placeholder="Ex: João Silva"
                           Text="{Binding Nome}"
                           Margin="10,0" />
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">
                <Label Text="E-mail" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                <Border StrokeShape="RoundRectangle 8">
                    <Entry Placeholder="cuidador@email.com"
                           Text="{Binding Email}"
                           Keyboard="Email"
                           Margin="10,0" />
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">
                <Label Text="Senha de Acesso" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                <Border StrokeShape="RoundRectangle 8">
                    <Entry Placeholder="******"
                           Text="{Binding Senha}"
                           IsPassword="True"
                           Margin="10,0" />
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">
                <Label Text="Telefone (Opcional)" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                <Border StrokeShape="RoundRectangle 8">
                    <Entry Placeholder="(11) 99999-9999"
                           Text="{Binding Telefone}"
                           Keyboard="Telephone"
                           Margin="10,0" />
                </Border>
            </VerticalStackLayout>

            <Button Text="CONCLUIR CADASTRO"
                    Command="{Binding SalvarCadastroCommand}"
                    HeightRequest="55"
                    FontSize="16"
                    FontAttributes="Bold"
                    Margin="0,20,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>