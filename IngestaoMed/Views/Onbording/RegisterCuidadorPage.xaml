<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:IngestaoMed.Core.ViewModels;assembly=IngestaoMed.Core"
             x:Class="IngestaoMed.Views.Onboarding.RegisterCuidadorPage"
             BackgroundColor="{StaticResource Gray100}"
             Title="Cadastro do Cuidador">

    <ContentPage.Resources>
        <Style x:Key="EntryFrameStyle" TargetType="Frame">
            <Setter Property="BackgroundColor" Value="{StaticResource White}" />
            <Setter Property="BorderColor" Value="{StaticResource Gray200}" />
            <Setter Property="Padding" Value="15,0" />
            <Setter Property="HeightRequest" Value="55" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HasShadow" Value="False" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="15" VerticalOptions="Start">

            <Label Text="Quem cuidará de você?"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="{StaticResource Gray900}"
                   HorizontalTextAlignment="Center" />

            <Label Text="Informe os dados da pessoa que receberá os alertas."
                   FontSize="16"
                   TextColor="{StaticResource Gray600}"
                   HorizontalTextAlignment="Center"
                   Margin="0,0,0,10" />

            <VerticalStackLayout Spacing="5">
                <Label Text="Nome do Cuidador" TextColor="{StaticResource Gray900}" FontAttributes="Bold" />
                <Frame Style="{StaticResource EntryFrameStyle}">
                    <Entry Placeholder="Ex: Maria Oliveira"
                           Text="{Binding NomeCuidador}"
                           TextColor="{StaticResource Black}"
                           PlaceholderColor="{StaticResource Gray500}" />
                </Frame>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="5">
                <Label Text="Telefone" TextColor="{StaticResource Gray900}" FontAttributes="Bold" />
                <Frame Style="{StaticResource EntryFrameStyle}">
                    <Entry Placeholder="(11) 99999-9999"
                           Text="{Binding TelefoneCuidador}"
                           Keyboard="Telephone"
                           TextColor="{StaticResource Black}"
                           PlaceholderColor="{StaticResource Gray500}" />
                </Frame>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="5">
                <Label Text="E-mail" TextColor="{StaticResource Gray900}" FontAttributes="Bold" />
                <Frame Style="{StaticResource EntryFrameStyle}">
                    <Entry Placeholder="cuidador@email.com"
                           Text="{Binding EmailCuidador}"
                           Keyboard="Email"
                           TextColor="{StaticResource Black}"
                           PlaceholderColor="{StaticResource Gray500}" />
                </Frame>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="5">
                <Label Text="Crie uma senha para o cuidador" TextColor="{StaticResource Gray900}" FontAttributes="Bold" />
                <Frame Style="{StaticResource EntryFrameStyle}">
                    <Entry Placeholder="******"
                           Text="{Binding SenhaCuidador}"
                           IsPassword="True"
                           TextColor="{StaticResource Black}"
                           PlaceholderColor="{StaticResource Gray500}" />
                </Frame>
            </VerticalStackLayout>

            <Button Text="Concluir Cadastro"
                    Command="{Binding SalvarCuidadorCommand}"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="{StaticResource White}"
                    HeightRequest="60"
                    FontSize="18"
                    FontAttributes="Bold"
                    CornerRadius="12"
                    Margin="0,20,0,20" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>