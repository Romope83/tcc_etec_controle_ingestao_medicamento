<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="clr-namespace:CommunityToolkit.Maui.Behaviors;assembly=CommunityToolkit.Maui"
             xmlns:vm="clr-namespace:IngestaoMed.Core.ViewModels;assembly=IngestaoMed.Core"
             xmlns:models="clr-namespace:IngestaoMed.Core.Models;assembly=IngestaoMed.Core"
             x:Class="IngestaoMed.Views.PacienteDetalhesPage"
             x:DataType="vm:PacienteDetalhesViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F8F9FA">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="25">

            <Label Text="Detalhes do Paciente" 
                   FontSize="24" 
                   TextColor="{StaticResource Primary}" 
                   FontAttributes="Bold" 
                   Margin="0,10,0,0" />

            <Border StrokeShape="RoundRectangle 20" 
                    Padding="20" 
                    BackgroundColor="White"
                    StrokeThickness="0">
                <Border.Shadow>
                    <Shadow Offset="0,5" Radius="10" Opacity="0.1" Brush="Black" />
                </Border.Shadow>

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding EditarPacienteCommand}" 
                                           CommandParameter="{Binding PacienteSelecionado.Id}" />
                </Border.GestureRecognizers>

                <VerticalStackLayout Spacing="20">
                    <Border StrokeShape="RoundRectangle 60" 
                            HeightRequest="120" 
                            WidthRequest="120" 
                            HorizontalOptions="Center"
                            StrokeThickness="0">
                        <Image Source="{Binding PacienteSelecionado.FotoPerfilPath, TargetNullValue='paciente_placeholder.png'}" 
                               Aspect="AspectFill" />
                    </Border>

                    <VerticalStackLayout Spacing="8" HorizontalOptions="Start">
                        <HorizontalStackLayout Spacing="5">
                            <Label Text="Nome:" TextColor="Gray" />
                            <Label Text="{Binding PacienteSelecionado.Nome}" FontSize="16" />
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="5">
                            <Label Text="Nascimento:" TextColor="Gray" />
                            <Label Text="{Binding PacienteSelecionado.DataNascimento, StringFormat='{0:dd/MM/yyyy}'}" FontSize="14" />
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="5">
                            <Label Text="E-mail:" TextColor="Gray" />
                            <Label Text="{Binding PacienteSelecionado.Email}" FontSize="14" />
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="5">
                            <Label Text="Telefone:" TextColor="Gray" />
                            <Label Text="{Binding PacienteSelecionado.TelefoneFormatado}" FontSize="14" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Button Text="Novo Tratamento" 
                    Command="{Binding NovoTratamentoCommand}" 
                    HorizontalOptions="Fill"
                    CornerRadius="10"
                    HeightRequest="45" />

            <VerticalStackLayout>

                <Label Text="Sem tratamentos" 
                       HorizontalOptions="Center" 
                       TextColor="Gray" 
                       FontSize="16"
                       Margin="0,10"
                       IsVisible="False">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding Tratamentos.Count}" Value="0">
                            <Setter Property="IsVisible" Value="True" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>

                <Label Text="Tratamentos" 
                       FontSize="20" 
                       TextColor="{StaticResource Primary}" 
                       FontAttributes="Bold"
                       Margin="5,0,0,15"
                       IsVisible="True">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding Tratamentos.Count}" Value="0">
                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Tratamentos}" Spacing="15">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:Tratamento">
                            <Border StrokeShape="RoundRectangle 15"
                                    StrokeThickness="1"
                                    Stroke="#E0E0E0"
                                    BackgroundColor="White"
                                    Padding="16"
                                    Margin="2,2,2,6">
                                <Border.Shadow>
                                    <Shadow Offset="0,4" Radius="8" Opacity="0.08" Brush="Black" />
                                </Border.Shadow>

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer 
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PacienteDetalhesViewModel}}, Path=EditarTratamentoCommand}"
                                        CommandParameter="{Binding Id}" />
                                </Border.GestureRecognizers>

                                <VerticalStackLayout Spacing="12">

                                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="{Binding Nome}" FontAttributes="Bold" FontSize="18" TextColor="Black" />
                                            <Label Text="{Binding Descricao}" FontSize="13" TextColor="Gray" />
                                            <Label Text="{Binding PeriodoFormatado}" FontAttributes="Bold" FontSize="12" TextColor="{StaticResource SecondaryDark}" Margin="0,4,0,0" />
                                        </VerticalStackLayout>

                                        <CheckBox Grid.Column="1" IsChecked="{Binding Ativo}" Color="{StaticResource SecondaryDark}" IsEnabled="False" VerticalOptions="Start" />
                                    </Grid>

                                    <Line Stroke="#F0F0F0" X2="400" HorizontalOptions="Center" />

                                    <Grid ColumnDefinitions="*, *, *">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="Medicamentos" FontSize="11" TextColor="Gray" />
                                            <Label Text="{Binding QtdRemedios, StringFormat='{0} remédio(s)'}" FontSize="13" FontAttributes="Bold" TextColor="Black" />
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="Center">
                                            <Label Text="Doses Tomadas" FontSize="11" TextColor="Gray" />
                                            <HorizontalStackLayout Spacing="3">
                                                <Label Text="{Binding DosesTomadasTratamento}" FontSize="13" FontAttributes="Bold" TextColor="Green" />
                                                <Label Text="/" FontSize="13" TextColor="Gray" />
                                                <Label Text="{Binding TotalDosesTratamento}" FontSize="13" FontAttributes="Bold" TextColor="Gray" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Grid.Column="2" Spacing="2" HorizontalOptions="End">
                                            <Label Text="Status Geral" FontSize="11" TextColor="Gray" HorizontalOptions="End" />
                                            <Label Text="{Binding StatusAndamento}" FontSize="13" FontAttributes="Bold" HorizontalOptions="End">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding StatusAndamento}" Value="Finalizado">
                                                        <Setter Property="TextColor" Value="Green" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding StatusAndamento}" Value="Em andamento">
                                                        <Setter Property="TextColor" Value="{StaticResource Primary}" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </VerticalStackLayout>
                                    </Grid>

                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>