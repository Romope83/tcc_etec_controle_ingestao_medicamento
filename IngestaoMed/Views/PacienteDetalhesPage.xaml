<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:IngestaoMed.Core.ViewModels;assembly=IngestaoMed.Core"
             xmlns:models="clr-namespace:IngestaoMed.Core.Models;assembly=IngestaoMed.Core"
             x:Class="IngestaoMed.Views.PacienteDetalhesPage"
             x:DataType="vm:PacienteDetalhesViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F8F9FA">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="25">

            <Label Text="Detalhes do Paciente" 
                   FontSize="24" 
                   TextColor="{StaticResource Primary}" 
                   FontAttributes="Bold" 
                   Margin="0,10,0,0" />

            <Border StrokeShape="RoundRectangle 20" 
                    Padding="20" 
                    BackgroundColor="White"
                    StrokeThickness="0">
                <Border.Shadow>
                    <Shadow Offset="0,5" Radius="10" Opacity="0.1" Brush="Black" />
                </Border.Shadow>

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding EditarPacienteCommand}" 
                                         CommandParameter="{Binding PacienteSelecionado.Id}" />
                </Border.GestureRecognizers>

                <VerticalStackLayout Spacing="20">
                    <Border StrokeShape="RoundRectangle 60" 
                            HeightRequest="120" 
                            WidthRequest="120" 
                            HorizontalOptions="Center"
                            StrokeThickness="0">
                        <Image Source="{Binding PacienteSelecionado.FotoPerfilPath, TargetNullValue='paciente_placeholder.png'}" 
                               Aspect="AspectFill" />
                    </Border>

                    <VerticalStackLayout Spacing="8" HorizontalOptions="Start">
                        <HorizontalStackLayout Spacing="5">
                            <Label Text="Nome:" TextColor="Gray" />
                            <Label Text="{Binding PacienteSelecionado.Nome}" FontSize="16" />
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="5">
                            <Label Text="Nascimento:" TextColor="Gray" />
                            <Label Text="{Binding PacienteSelecionado.DataNascimento, StringFormat='{0:dd/MM/yyyy}'}" FontSize="14" />
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="5">
                            <Label Text="E-mail:" TextColor="Gray" />
                            <Label Text="{Binding PacienteSelecionado.Email}" FontSize="14" />
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="5">
                            <Label Text="Telefone:" TextColor="Gray" />
                            <Label Text="{Binding PacienteSelecionado.Telefone}" FontSize="14" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Button Text="Novo Tratamento" 
                    Command="{Binding NovoTratamentoCommand}" 
                    HorizontalOptions="Fill"
                    CornerRadius="10"
                    HeightRequest="45" />

            <VerticalStackLayout>

                <Label Text="Sem tratamentos" 
                       HorizontalOptions="Center" 
                       TextColor="Gray" 
                       FontSize="16"
                       Margin="0,10"
                       IsVisible="False">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding Tratamentos.Count}" Value="0">
                            <Setter Property="IsVisible" Value="True" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>

                <Label Text="Tratamentos" 
                       FontSize="20" 
                       TextColor="{StaticResource Primary}" 
                       FontAttributes="Bold"
                       Margin="0,0,0,10"
                       IsVisible="True">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding Tratamentos.Count}" Value="0">
                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>

                <CollectionView ItemsSource="{Binding Tratamentos}">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="20" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Tratamento">
                            <Border StrokeShape="RoundRectangle 20" 
                                    Padding="20" 
                                    BackgroundColor="White"
                                    StrokeThickness="0">
                                <Border.Shadow>
                                    <Shadow Offset="0,5" Radius="10" Opacity="0.1" Brush="Black" />
                                </Border.Shadow>

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer 
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PacienteDetalhesViewModel}}, Path=EditarTratamentoCommand}"
                                        CommandParameter="{Binding Id}" />
                                </Border.GestureRecognizers>

                                <VerticalStackLayout Spacing="10">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="{Binding Nome}" FontAttributes="Bold" FontSize="18" TextColor="Black" />
                                            <Label Text="{Binding Descricao}" FontSize="13" TextColor="Gray" />
                                            <Label Text="{Binding PeriodoFormatado}" FontSize="12" TextColor="{StaticResource Primary}" />
                                        </VerticalStackLayout>

                                        <CheckBox Grid.Column="1" IsChecked="{Binding Ativo}" Color="Gold" IsEnabled="False" />
                                    </Grid>

                                    <Label Text="REMÉDIOS" FontAttributes="Bold" TextColor="Green" FontSize="11" Margin="0,10,0,0" />

                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Remedios}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="models:MedicamentoTratamento">
                                                <VerticalStackLayout Spacing="1" Margin="0,0,0,12">
                                                    <Label Text="{Binding NomeMedicamento}" TextColor="Red" FontAttributes="Bold" />
                                                    <HorizontalStackLayout Spacing="10">
                                                        <Label Text="{Binding IntervaloHoras, StringFormat='a cada {0}h'}" FontSize="12" />
                                                        <Label Text="{Binding Dosagem}" FontSize="12" />
                                                    </HorizontalStackLayout>
                                                    <Label Text="{Binding Instrucoes}" FontSize="12" TextColor="Gray" />
                                                </VerticalStackLayout>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>