<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:IngestaoMed.Core.ViewModels;assembly=IngestaoMed.Core"
             x:Class="IngestaoMed.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             Title="Login">

    <VerticalStackLayout Padding="30" Spacing="15" VerticalOptions="Center">

        <Label Text="Acesso ao Sistema" FontSize="24" HorizontalOptions="Center" />

        <Entry Placeholder="E-mail" 
               Text="{Binding Email}" 
               Keyboard="Email" />

        <Entry Placeholder="Senha" 
               Text="{Binding Senha}" 
               IsPassword="True" />

        <Button Text="Entrar" 
                Command="{Binding EntrarCommand}" 
                Margin="0,20,0,0" />

    </VerticalStackLayout>
</ContentPage>