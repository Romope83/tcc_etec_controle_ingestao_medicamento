<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:IngestaoMed.Core.ViewModels;assembly=IngestaoMed.Core"
             x:Class="IngestaoMed.Views.CadastroMedicamentoPage"
             Title="Novo Medicamento"
             x:DataType="vm:CadastroMedicamentoViewModel">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="30">

            <Label Text="Cadastrar Medicamento" 
                   FontSize="24" 
                   FontAttributes="Bold" 
                   HorizontalOptions="Center" />

            <VerticalStackLayout Spacing="5">
                <Label Text="Nome Comercial *" FontSize="14" TextColor="Gray" />
                <Entry Text="{Binding NomeComercial}" 
                       Placeholder="Ex: Dipirona, Losartana" 
                       ClearButtonVisibility="WhileEditing" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="5">
                <Label Text="Dosagem (Opcional)" FontSize="14" TextColor="Gray" />
                <Entry Text="{Binding Dosagem}" 
                       Placeholder="Ex: 500mg, 50ml" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="5">
                <Label Text="Forma de Ingestão" FontSize="14" TextColor="Gray" />
                <Picker Title="Selecione..." 
                        ItemsSource="{Binding FormasIngestaoDisponiveis}" 
                        SelectedItem="{Binding FormaIngestao}" />
            </VerticalStackLayout>

            <Button Text="Salvar Medicamento" 
                    Command="{Binding SalvarCommand}" 
                    Margin="0, 20, 0, 0"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>