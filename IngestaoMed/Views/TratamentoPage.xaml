<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:IngestaoMed.Core.ViewModels;assembly=IngestaoMed.Core"
             xmlns:models="clr-namespace:IngestaoMed.Core.Models;assembly=IngestaoMed.Core"
             x:Class="IngestaoMed.Views.TratamentoPage"
             x:DataType="vm:TratamentoViewModel"
             BackgroundColor="White">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label Text="Editar Tratamento" 
                   FontSize="22" 
                   TextColor="{StaticResource Primary}" 
                   FontAttributes="Bold"
                   Margin="0,0,0,10">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding TratamentoId}" Value="0">
                        <Setter Property="Text" Value="Tratamento Novo"/>
                    </DataTrigger>
                </Label.Triggers>
            </Label>

            <VerticalStackLayout Spacing="5">
                <Label Text="Nome Tratamento" TextColor="Gray" />
                <Entry Text="{Binding Nome}" Placeholder="Ex: Pneumonia" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="5">
                <Label Text="Descrição" TextColor="Gray" />
                <Border StrokeShape="RoundRectangle 10" StrokeThickness="1" Stroke="#E0E0E0">
                    <Editor Text="{Binding Descricao}" 
                            AutoSize="TextChanges" 
                            HeightRequest="100" 
                            Placeholder="Notas sobre o tratamento..." />
                </Border>
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*, *" ColumnSpacing="15">
                <VerticalStackLayout Grid.Column="0" Spacing="5">
                    <Label Text="Início:" TextColor="Gray" />
                    <DatePicker Date="{Binding DataInicio}" Format="dd.MM.yyyy" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="5">
                    <Label Text="Fim:" TextColor="Gray" />
                    <DatePicker Date="{Binding DataFim}" Format="dd.MM.yyyy" />
                </VerticalStackLayout>
            </Grid>

            <HorizontalStackLayout Spacing="10" VerticalOptions="Center" Margin="0,10">
                <Switch x:Name="swAtivado" IsToggled="{Binding Ativado}" OnColor="{StaticResource Primary}" />
                <Label VerticalOptions="Center" FontSize="16" TextColor="Gray">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference swAtivado}, Path=IsToggled}" Value="True">
                            <Setter Property="Text" Value="Desativar tratamento" />
                        </DataTrigger>
                        <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference swAtivado}, Path=IsToggled}" Value="False">
                            <Setter Property="Text" Value="Ativar tratamento" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </HorizontalStackLayout>

            <VerticalStackLayout Spacing="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Text="Salvar" 
                            Command="{Binding SalvarCommand}"
                            BackgroundColor="{StaticResource Primary}" 
                            TextColor="White"
                            CornerRadius="10"
                            HeightRequest="45"
                            HorizontalOptions="Fill" />

                    <Button Grid.Column="1"
                            Text="Excluir" 
                            Command="{Binding ExcluirTratamentoCommand}"
                            BackgroundColor="#FFCDD2" 
                            TextColor="#B71C1C" 
                            CornerRadius="10"
                            HeightRequest="45"
                            WidthRequest="120"
                            Margin="10,0,0,0">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding TratamentoId}" Value="0">
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </Grid>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="15">
                <VerticalStackLayout.Triggers>
                    <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding TratamentoId}" Value="0">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                </VerticalStackLayout.Triggers>

                <Line Stroke="LightGray" X2="400" HorizontalOptions="Center" Margin="0,10" />

                <Button Text="Adicionar Agendamento" 
                        Command="{Binding AdicionarMedicamentoCommand}"
                        BackgroundColor="#A5D6A7" 
                        TextColor="Black"
                        CornerRadius="10"
                        HeightRequest="45" />

                <VerticalStackLayout Spacing="10" Margin="0,10,0,0">
                    <VerticalStackLayout.Triggers>
                        <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding TratamentoId}" Value="0">
                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                    </VerticalStackLayout.Triggers>

                    <Label Text="Medicamentos e Horários" 
           FontSize="16" 
           FontAttributes="Bold" 
           TextColor="Gray" 
           Margin="5,0" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding MedicamentosVinculados}" Spacing="12">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:MedicamentoTratamento">
                                <Border StrokeShape="RoundRectangle 12"
                        StrokeThickness="0"
                        BackgroundColor="White"
                        Padding="16"
                        Margin="2,2,2,8">
                                    <Border.Shadow>
                                        <Shadow Offset="0,4" Radius="8" Opacity="0.1" Brush="Black" />
                                    </Border.Shadow>

                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer 
                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TratamentoViewModel}}, Path=SelecionarMedicamentoVinculadoCommand}"
                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>

                                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="15">
                                        <Border Grid.Column="0" 
                                BackgroundColor="#F0F4F8" 
                                StrokeShape="RoundRectangle 25" 
                                HeightRequest="50" 
                                WidthRequest="50"
                                StrokeThickness="0">
                                            <Label Text="💊" HorizontalOptions="Center" VerticalOptions="Center" FontSize="20"/>
                                        </Border>

                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                            <Label Text="{Binding NomeMedicamento}" 
                                   FontAttributes="Bold" 
                                   FontSize="16" 
                                   TextColor="{StaticResource Primary}" />
                                            <Label Text="{Binding Dosagem}" 
                                   FontSize="13" 
                                   TextColor="Gray" />
                                            <HorizontalStackLayout Spacing="5">
                                                <Label Text="🕒" FontSize="12" VerticalOptions="Center"/>
                                                <Label Text="{Binding IntervaloHoras, StringFormat='A cada {0} horas'}" 
                                       FontSize="12" 
                                       TextColor="Gray" 
                                       VerticalOptions="Center"/>
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>

                                        <Label Grid.Column="2" 
                               Text="›" 
                               FontSize="28" 
                               TextColor="LightGray" 
                               VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>