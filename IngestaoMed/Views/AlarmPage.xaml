<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="IngestaoMed.UI.Views.AlarmPage"
             BackgroundColor="{StaticResource Gray950}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*, Auto, Auto" Padding="30">

        <!-- Área de Alerta e Identificação -->
        <VerticalStackLayout Grid.Row="0" Spacing="20" VerticalOptions="Center">
            <Image Source="pill_icon.png" HeightRequest="100" WidthRequest="100" HorizontalOptions="Center" />

            <Label Text="HORA DO MEDICAMENTO" 
                   TextColor="{StaticResource Primary}"
                   FontSize="14" FontAttributes="Bold" HorizontalTextAlignment="Center" CharacterSpacing="2"/>

            <Label Text="{Binding AgendamentoAtual.Tratamento.Nome}" 
                   FontSize="32" FontAttributes="Bold" HorizontalTextAlignment="Center" />

            <Label Text="{Binding AgendamentoAtual.Tratamento.Dosagem}" 
                   FontSize="22" Opacity="0.8" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <!-- Mensagem de Apoio/Descrição -->
        <Label Grid.Row="1" 
               Text="{Binding AgendamentoAtual.Tratamento.Descricao}"
               HorizontalTextAlignment="Center" Margin="0,0,0,40" FontAttributes="Italic"/>

        <!-- Botões de Ação Direta -->
        <VerticalStackLayout Grid.Row="2" Spacing="15">
            <Button Text="CONFIRMAR INGESTÃO" 
                    Command="{Binding ConfirmarIngestaoCommand}"
                    BackgroundColor="{StaticResource Success}"
                    HeightRequest="80" FontSize="18" FontAttributes="Bold" />

            <Button Text="Soneca (10 min)" 
                    Command="{Binding AdiarSonecaCommand}"
                    BackgroundColor="Transparent"
                    BorderColor="{StaticResource Gray400}"
                    BorderWidth="1"
                    HeightRequest="60" />
        </VerticalStackLayout>

    </Grid>
</ContentPage>